# Local dev environment for docker-compose. DO NOT commit real secrets.

# Postgres
POSTGRES_USER=warden
POSTGRES_PASSWORD=warden
POSTGRES_DB=warden

# Npgsql pool (high concurrency)
DB_MAX_POOL_SIZE=50
DB_MIN_POOL_SIZE=5

# Redis L2 cache (docker-compose service name "redis")
# Leave empty to use in-process memory cache only
REDIS_CONNECTION=redis:6379
REDIS_MAXMEMORY=256mb

# Warden API
SYSTEM_PASSWORD=ChangeMe_L0cal!
ACCESS_TOKEN_KEY=06d27323-614c-4980-b108-d35b2e0fb224
REFRESH_TOKEN_KEY=5e38d27c-223a-477e-b8ab-8a5705b18675

# AI (optional — leave empty to disable)
AI_ENDPOINT=
AI_MODEL=
WARDEN_AI_API_KEY=

# Frontend (compose maps web on host :8081)
FRONTEND_URL=http://localhost:8081
OPENAPI_ENABLED=true
TRUSTED_PROXIES=

# CI token for compose scanner profile / UI scan runner (Settings → CI Token)
WARDEN_TOKEN=

# Scan runner — auto | docker | kubernetes
SCAN_BACKEND=auto
SCAN_IMAGE_PREFIX=warden-
SCAN_NETWORK=warden_default
SCAN_GIT_TOKEN=
SCAN_WARDEN_URL=http://warden:8080
OSV_SERVICE_URL=http://osv-api:9000

# Host docker.sock group (stat -c %g /var/run/docker.sock)
DOCKER_GID=957
